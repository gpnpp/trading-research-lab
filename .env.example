# Скопируйте в .env и заполните. Файл .env в репозиторий не коммитится.
# Telegram-уведомления (необязательно): токен от @BotFather и ваш chat_id (см. локальный скрипт настройки).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Solana-трейдер. По умолчанию бумажный режим. Включение реальных сделок — только осознанно, с малым балансом.
SOL_LIVE=false
SOL_ORDER_SOL=0.02
SOL_MAX_OPEN=3
SOL_MIN_SCORE=70
SOL_MODES=scalp,day
SOL_DAILY_LOSS_SOL=0.05
